// Copy to wrangler.jsonc, fill in the three values, then: npx wrangler deploy
{
  "name": "waypost-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "<your Cloudflare account id>",
  "routes": [{ "pattern": "<waypost.example.com>", "custom_domain": true }],
  "vars": { "ORIGIN": "<https://your-server.your-tailnet.ts.net>" },
  "observability": { "enabled": false }
}
